import { createDefaultTemplateContent, TemplateContent } from '@templatical/types';

function withStyles(blocks: any[]): any[] {
  return blocks.map(block => ({
    ...block,
    styles: { 
      padding: { top: 16, bottom: 16, left: 24, right: 24 },
      ...(block.styles || {})
    }
  }));
}

export interface TemplateBlueprint {
  id: string;
  name: string;
  description: string;
  category: "NEWSLETTER" | "PROMOTIONAL" | "PERSONALIZED" | "GENERAL" | "TRANSACTIONAL";
  icon?: string;
  thumbnailUrl?: string; // Optional image URL if we want visual previews
  getContent: () => TemplateContent;
}

