# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@host:port/database"

# ─── Security ─────────────────────────────────────────────────────────────
# 32-byte encryption key used for encrypting SMTP passwords in the database
# In production, this MUST be exactly 32 characters long
ENCRYPTION_KEY="your_32_character_encryption_key_here"

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cloudinary (Image Uploads) ─────────────────────────────────────────────
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── Google Drive Picker Integration ─────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID="your_google_app_id"
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY="your_google_api_key"
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# ─── AI (Google Gemini) ──────────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key"

# ─── SMTP (Nodemailer Fallback / Notifications) ──────────────────────────────
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT=587
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="BulkyMailer <hello@yourdomain.com>"

# ─── Resend API (Optional Legacy Fallback) ──────────────────────────────────
RESEND_API_KEY="re_your_resend_key"
RESEND_FROM="BulkyMailer <hello@yourdomain.com>"
RESEND_WEBHOOK_SECRET="whsec_your_webhook_secret"
