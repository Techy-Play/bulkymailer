// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  EDITOR
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TeamSize {
  SOLO
  TWO_TO_FIVE
  SIX_TO_TEN
  ELEVEN_TO_FIFTY
  FIFTY_PLUS
}

enum ContactRange {
  LESS_THAN_1000
  FROM_1K_TO_5K
  FROM_5K_TO_20K
  FROM_20K_TO_50K
  ABOVE_50K
}

// ---------------------------------------------------------------------------
// Organization — multi-user org model
// ---------------------------------------------------------------------------

model Organization {
  id           String @id @default(cuid())

  name         String

  website      String?
  logoUrl      String?  // Cloudinary URL for org logo

  addressLine1 String
  addressLine2 String?

  city         String
  state        String?
  postalCode   String
  country      String

  teamSize     TeamSize
  contactRange ContactRange

  sellsOnline  Boolean

  marketingOptIn Boolean @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
}

// ---------------------------------------------------------------------------
// User — login credentials + profile
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())

  email        String     @unique
  passwordHash String

  firstName    String
  lastName     String
  phoneNumber  String?

  role         Role       @default(OWNER)
  status       UserStatus @default(PENDING)

  emailVerified           Boolean  @default(false)
  isOnboardingCompleted   Boolean  @default(false)

  // OTP verification (6-digit code stored here)
  otpCode        String?
  otpExpiresAt   DateTime?
  otpAttempts    Int      @default(0)
  
  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // Cloudinary profile image
  profileImageUrl String?

  // Free tier tracking (100 emails/month)
  subscriptionType     String   @default("free")
  emailsSentThisMonth  Int      @default(0)
  emailsMonthResetAt   DateTime?

  // Dashboard navigation preference: "sidebar" | "topnav"
  navLayout    String @default("sidebar")

  lastLoginAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Optional org membership
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Auth tokens (kept for resend compatibility)
  verificationTokens EmailVerificationToken[]

  // Contact lists
  contactLists ContactList[]
  
  senderProfiles SenderProfile[]
  templates      Template[]
  campaigns      Campaign[]
}

// ---------------------------------------------------------------------------
// Email Verification Token — kept for backward compat / resend flow
// ---------------------------------------------------------------------------

model EmailVerificationToken {
  id        String   @id @default(cuid())

  token     String   @unique
  expiresAt DateTime

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Contact Lists — user-owned lists of contacts
// ---------------------------------------------------------------------------

model ContactList {
  id          String    @id @default(cuid())
  name        String
  description String?

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  contacts    Contact[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  campaigns   Campaign[]
}

// ---------------------------------------------------------------------------
// Contact — individual contact in a list
// ---------------------------------------------------------------------------

model Contact {
  id           String   @id @default(cuid())

  email        String
  firstName    String?
  lastName     String?
  phone        String?

  // Any extra columns from CSV stored as key-value JSON
  customFields Json?

  listId       String
  list         ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([email, listId])
}

// ---------------------------------------------------------------------------
// Template Categories
// ---------------------------------------------------------------------------

enum TemplateCategory {
  NEWSLETTER
  PROMOTIONAL
  PERSONALIZED
  GENERAL
  TRANSACTIONAL
}

// ---------------------------------------------------------------------------
// Campaign Status
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Sender Profile
// ---------------------------------------------------------------------------

model SenderProfile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromName  String
  fromEmail String
  replyTo   String?
  isDefault Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  campaigns Campaign[]
}

// ---------------------------------------------------------------------------
// Template
// ---------------------------------------------------------------------------

model Template {
  id          String           @id @default(cuid())
  userId      String?          // null = system global
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  category    TemplateCategory @default(GENERAL)
  htmlContent String           @db.Text
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  campaigns   Campaign[]
}

// ---------------------------------------------------------------------------
// Campaign
// ---------------------------------------------------------------------------

model Campaign {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  templateId           String?
  template             Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  contactListId        String
  contactList          ContactList    @relation(fields: [contactListId], references: [id], onDelete: Restrict)
  
  senderProfileId      String?
  senderProfile        SenderProfile? @relation(fields: [senderProfileId], references: [id], onDelete: SetNull)
  
  subject              String
  
  // Snapshots for immutability
  renderedHtml         String?        @db.Text
  subjectSnapshot      String?
  fromNameSnapshot     String?
  fromEmailSnapshot    String?
  
  // Analytics / Tracking
  totalRecipients      Int            @default(0)
  successfulRecipients Int            @default(0)
  failedRecipients     Int            @default(0)
  openedCount          Int            @default(0)
  clickedCount         Int            @default(0)
  
  status               CampaignStatus @default(DRAFT)
  
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}
