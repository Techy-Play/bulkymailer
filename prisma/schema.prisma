// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  EDITOR
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrgRole {
  OWNER
  ADMIN
  MARKETING_MANAGER
  CAMPAIGN_MANAGER
  CONTENT_MANAGER
  SALES
  ANALYST
  VIEWER
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TeamSize {
  SOLO
  TWO_TO_FIVE
  SIX_TO_TEN
  ELEVEN_TO_FIFTY
  FIFTY_PLUS
}

enum ContactRange {
  LESS_THAN_1000
  FROM_1K_TO_5K
  FROM_5K_TO_20K
  FROM_20K_TO_50K
  ABOVE_50K
}

enum EventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
}

enum BounceType {
  HARD
  SOFT
}

// ---------------------------------------------------------------------------
// Organization — multi-user org model
// ---------------------------------------------------------------------------

model Organization {
  id           String @id @default(cuid())

  name         String

  website      String?
  logoUrl      String?  // Cloudinary URL for org logo

  addressLine1 String
  addressLine2 String?

  city         String
  state        String?
  postalCode   String
  country      String

  teamSize     TeamSize
  contactRange ContactRange

  sellsOnline  Boolean

  marketingOptIn Boolean @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  
  // New RBAC / Multi-tenant relations
  memberships    OrganizationMembership[]
  invitations    OrganizationInvitation[]
  
  // Tenanted Resources
  contactLists   ContactList[]
  contacts       Contact[]
  senderProfiles SenderProfile[]
  templates      Template[]
  campaigns      Campaign[]
  mediaAssets    MediaAsset[]
}

// ---------------------------------------------------------------------------
// User — login credentials + profile
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())

  email        String     @unique
  passwordHash String

  firstName    String
  lastName     String
  phoneNumber  String?

  role         Role       @default(OWNER)
  status       UserStatus @default(PENDING)

  emailVerified           Boolean  @default(false)
  isOnboardingCompleted   Boolean  @default(false)

  // OTP verification (6-digit code stored here)
  otpCode        String?
  otpExpiresAt   DateTime?
  otpAttempts    Int      @default(0)
  
  // Password Reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Cloudinary profile image
  profileImageUrl String?

  // Free tier tracking (100 emails/month)
  subscriptionType     String   @default("free")
  emailsSentThisMonth  Int      @default(0)
  emailsMonthResetAt   DateTime?

  // Dashboard navigation preference: "sidebar" | "topnav"
  navLayout    String @default("sidebar")

  lastLoginAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Optional org membership (LEGACY - Do not remove yet)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Platform Level Role
  isSuperAdmin Boolean @default(false)

  // Multi-tenant Memberships
  memberships OrganizationMembership[]

  // Auth tokens (kept for resend compatibility)
  verificationTokens EmailVerificationToken[]

  // Invitations created by this user
  invitationsSent OrganizationInvitation[] @relation("InvitedBy")

  // Contact lists
  contactLists ContactList[]
  
  senderProfiles SenderProfile[]
  templates      Template[]
  campaigns      Campaign[]
  mediaAssets    MediaAsset[]
}

// ---------------------------------------------------------------------------
// Email Verification Token — kept for backward compat / resend flow
// ---------------------------------------------------------------------------

model EmailVerificationToken {
  id        String   @id @default(cuid())

  token     String   @unique
  expiresAt DateTime

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Organization Membership — Multi-tenant RBAC
// ---------------------------------------------------------------------------

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(VIEWER)
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Organization Invitations
// ---------------------------------------------------------------------------

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole          @default(VIEWER)
  status         InvitationStatus @default(PENDING)
  invitedById    String
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([tokenHash])
  @@index([status])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String
  targetUserId   String?
  organizationId String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([actorUserId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Contact Lists — user-owned lists of contacts
// ---------------------------------------------------------------------------

model ContactList {
  id          String    @id @default(cuid())
  name        String
  description String?

  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contacts    Contact[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  campaigns   Campaign[]
}

// ---------------------------------------------------------------------------
// Contact — individual contact in a list
// ---------------------------------------------------------------------------

model Contact {
  id           String   @id @default(cuid())

  email        String
  firstName    String?
  lastName     String?
  phone        String?

  // Any extra columns from CSV stored as key-value JSON
  customFields Json?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  listId       String
  list         ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([email, listId])
}

// ---------------------------------------------------------------------------
// Template Categories
// ---------------------------------------------------------------------------

enum TemplateCategory {
  NEWSLETTER
  PROMOTIONAL
  PERSONALIZED
  GENERAL
  TRANSACTIONAL
  WELCOME
  PRODUCT
  EVENT
  E_COMMERCE
  SECURITY
  ENGAGEMENT
  SEASONAL
}

// ---------------------------------------------------------------------------
// Campaign Status
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Sender Profile
// ---------------------------------------------------------------------------

model SenderProfile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromName  String
  fromEmail String
  replyTo   String?
  isDefault Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  campaigns Campaign[]
}

// ---------------------------------------------------------------------------
// Template Generation
// ---------------------------------------------------------------------------

enum TemplateGeneration {
  LEGACY
  MODERN
}

// ---------------------------------------------------------------------------
// Template
// ---------------------------------------------------------------------------

model Template {
  id          String           @id @default(cuid())
  slug        String?
  userId      String?          // null = system global
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name        String
  category    TemplateCategory @default(GENERAL)
  generation  TemplateGeneration @default(MODERN)
  htmlContent String           @db.Text
  jsonTree    Json?
  
  description String?
  previewText String?          // Shown in inbox after subject
  isFavorite  Boolean          @default(false)
  usageCount  Int              @default(0)  // incremented when used in a campaign
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  campaigns   Campaign[]
  versions    TemplateVersion[]
}

// ---------------------------------------------------------------------------
// Template Version History
// ---------------------------------------------------------------------------

model TemplateVersion {
  id          String   @id @default(cuid())
  
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  version     Int
  versionName String?
  
  generation  TemplateGeneration @default(MODERN)
  htmlContent String   @db.Text
  jsonTree    Json?
  
  createdAt   DateTime @default(now())

  @@unique([templateId, version])
}


// ---------------------------------------------------------------------------
// Campaign
// ---------------------------------------------------------------------------

model Campaign {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId       String?
  organization         Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  templateId           String?
  template             Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  contactListId        String?
  contactList          ContactList?   @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  
  senderProfileId      String?
  senderProfile        SenderProfile? @relation(fields: [senderProfileId], references: [id], onDelete: SetNull)
  
  campaignName         String         @default("Untitled Campaign")
  subject              String         @default("")
  
  // Immutable snapshots — copied at send time so edits to template/sender don't affect sent campaigns
  htmlSnapshot         String?        @db.Text   // copy of template htmlContent at send time
  previewTextSnapshot  String?                   // copy of template previewText at send time
  subjectSnapshot      String?
  fromNameSnapshot     String?
  fromEmailSnapshot    String?
  
  // Analytics / Tracking
  totalRecipients      Int            @default(0)
  successfulRecipients Int            @default(0)
  failedRecipients     Int            @default(0)
  openedCount          Int            @default(0)
  uniqueOpens          Int            @default(0)
  clickedCount         Int            @default(0)
  uniqueClicks         Int            @default(0)
  hardBounces          Int            @default(0)
  softBounces          Int            @default(0)
  complaints           Int            @default(0)
  unsubscribes         Int            @default(0)
  
  status               CampaignStatus @default(DRAFT)
  
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  events               CampaignEvent[]
}

// ---------------------------------------------------------------------------
// Campaign Event Log (Real-time Webhook Events & Granular Tracking)
// ---------------------------------------------------------------------------

model CampaignEvent {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  recipient   String
  eventType   EventType
  
  bounceType  BounceType?
  bounceReason String?
  linkUrl     String?
  linkTag     String?    // Button, Image, Footer, Hero, Logo
  
  device      String?    // Desktop, Mobile, Tablet
  emailClient String?    // Gmail, Outlook, Apple Mail, Yahoo, Other
  country     String?
  city        String?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// Media Asset (Library)
// ---------------------------------------------------------------------------

model MediaAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  url       String   // Cloudinary URL
  filename  String
  width     Int?
  height    Int?
  sizeBytes Int?
  mimeType  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
